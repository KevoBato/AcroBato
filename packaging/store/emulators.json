    {
      "id": "linuxloader", "name": "Linux Loader (Lindbergh)", "group": "EMULATORS",
      "description": "Sega Lindbergh arcade games (needs the 32-bit system libraries Steam installs)",
      "_note": "official AppImage, used unpacked at Batocera's /usr/bin/linuxloader layout: the program behind a wrapper that sets the AppImage's 32-bit library path",
      "source": {"type": "github", "repo": "lindbergh-loader/linuxloader", "release": "latest", "asset": "^linuxloader\\.AppImage$",
                 "archive": "appimage", "exe": "usr/bin/linuxloader",
                 "env": {"LD_LIBRARY_PATH": "$ROOT/usr/lib32:$LD_LIBRARY_PATH",
                         "VK_ICD_FILENAMES": "$ROOT/usr/share/vulkan/icd.d/intel_hasvk_icd.i686.json:$ROOT/usr/share/vulkan/icd.d/intel_icd.i686.json:$ROOT/usr/share/vulkan/icd.d/lvp_icd.i686.json:$ROOT/usr/share/vulkan/icd.d/radeon_icd.i686.json:$ROOT/usr/share/vulkan/icd.d/virtio_icd.i686.json"}},
      "install": "/usr/bin/linuxloader/linuxloader",
      "files": [
        {"from": "usr/lib32/linuxloader.so", "install": "/usr/bin/linuxloader/linuxloader.so"}
      ],
      "extras": [
        {"url": "https://raw.githubusercontent.com/batocera-linux/batocera.linux/23d3fcfea8a9a31b045d188ea39806ef01251efb/package/batocera/emulators/linuxloader/linuxloader.ini",
         "install": "/usr/bin/linuxloader/linuxloader.ini", "sha256": "6a75ff957bf3df6c4b5409a6bf7295efd428896c86933e49d785036223587195"},
        {"url": "https://raw.githubusercontent.com/batocera-linux/batocera.linux/23d3fcfea8a9a31b045d188ea39806ef01251efb/package/batocera/emulators/linuxloader/controls.ini",
         "install": "/usr/bin/linuxloader/controls.ini", "sha256": "87413b3da111279a1a5731b9e92f4d20d1ef83b3764302f272bb767a9d894cf1"}
      ]
    },
