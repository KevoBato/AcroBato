{
  "_comment": "Emulators offered in Updates & Downloads > Content Downloader. 'install' is the path Batocera's launcher runs; it is created under <userdata>/emulators/usr/... . Sources are each project's official releases.",
  "emulators": [
    {
      "id": "pcsx2", "name": "PCSX2", "group": "EMULATORS",
      "description": "PlayStation 2 emulator",
      "source": {"type": "github", "repo": "PCSX2/pcsx2", "release": "latest", "asset": "^pcsx2-v.*-linux-appimage-x64-Qt\\.AppImage$"},
      "install": "/usr/pcsx2/bin/pcsx2-qt"
    },
    {
      "id": "duckstation", "name": "DuckStation", "group": "EMULATORS",
      "description": "PlayStation 1 emulator",
      "source": {"type": "github", "repo": "stenzek/duckstation", "release": "latest", "asset": "^DuckStation-x64\\.AppImage$"},
      "install": "/usr/bin/duckstation-qt"
    },
    {
      "id": "rpcs3", "name": "RPCS3", "group": "EMULATORS",
      "description": "PlayStation 3 emulator",
      "source": {"type": "github", "repo": "RPCS3/rpcs3-binaries-linux", "release": "latest", "asset": "^rpcs3-.*_linux64\\.AppImage$"},
      "install": "/usr/bin/rpcs3"
    },
    {
      "id": "ppsspp", "name": "PPSSPP", "group": "EMULATORS",
      "description": "PlayStation Portable emulator",
      "source": {"type": "github", "repo": "hrydgard/ppsspp", "release": "latest", "asset": "^PPSSPP-.*-anylinux-x86_64\\.AppImage$"},
      "install": "/usr/bin/PPSSPP"
    },
    {
      "id": "shadps4", "name": "shadPS4", "group": "EMULATORS",
      "description": "PlayStation 4 emulator (experimental)",
      "source": {"type": "github", "repo": "shadps4-emu/shadPS4", "release": "latest", "asset": "^shadps4-linux-sdl-.*\\.zip$", "member": "\\.AppImage$"},
      "install": "/usr/bin/shadps4"
    },
    {
      "id": "vita3k", "name": "Vita3K", "group": "EMULATORS",
      "description": "PlayStation Vita emulator (experimental)",
      "source": {"type": "github", "repo": "Vita3K/Vita3K", "release": "tags/continuous", "asset": "^Vita3K-x86_64\\.AppImage$"},
      "install": "/usr/bin/vita3k/Vita3K"
    },
    {
      "id": "dolphin", "name": "Dolphin", "group": "EMULATORS",
      "description": "GameCube and Wii emulator (installed from Flathub)",
      "source": {"type": "flatpak", "ref": "org.DolphinEmu.dolphin-emu", "remote": "flathub"},
      "install": "/usr/bin/dolphin-emu"
    },
    {
      "id": "cemu", "name": "Cemu", "group": "EMULATORS",
      "description": "Wii U emulator (no checksum published upstream)",
      "source": {"type": "github", "repo": "cemu-project/Cemu", "release": "latest", "asset": "^Cemu-.*-x86_64\\.AppImage$"},
      "install": "/usr/bin/cemu/cemu"
    },
    {
      "id": "azahar", "name": "Azahar", "group": "EMULATORS",
      "description": "Nintendo 3DS emulator",
      "source": {"type": "github", "repo": "azahar-emu/azahar", "release": "latest", "asset": "^azahar\\.AppImage$"},
      "install": "/usr/bin/azahar"
    },
    {
      "id": "melonds", "name": "melonDS", "group": "EMULATORS",
      "description": "Nintendo DS emulator",
      "source": {"type": "github", "repo": "melonDS-emu/melonDS", "release": "latest", "asset": "^melonDS-.*-appimage-x86_64\\.zip$", "member": "\\.AppImage$"},
      "install": "/usr/bin/melonDS"
    },
    {
      "id": "xemu", "name": "xemu", "group": "EMULATORS",
      "description": "Original Xbox emulator",
      "source": {"type": "github", "repo": "xemu-project/xemu", "release": "latest", "asset": "^xemu-[0-9.]+-x86_64\\.AppImage$"},
      "install": "/usr/bin/xemu"
    },
    {
      "id": "flycast", "name": "Flycast", "group": "EMULATORS",
      "description": "Dreamcast, Naomi and Atomiswave emulator",
      "source": {"type": "github", "repo": "flyinghead/flycast", "release": "latest", "asset": "^flycast-x86_64.*\\.AppImage$"},
      "install": "/usr/bin/flycast"
    },
    {
      "id": "eden", "name": "Eden", "group": "EMULATORS",
      "description": "Nintendo Switch emulator",
      "source": {"type": "gitea", "server": "https://git.eden-emu.dev", "repo": "eden-emu/eden", "release": "latest", "asset": "^Eden-Linux-.*-amd64-gcc-standard\\.AppImage$"},
      "install": "/usr/bin/eden", "systems": ["switch"]
    },
    {
      "id": "ryujinx", "name": "Ryujinx", "group": "EMULATORS",
      "description": "Nintendo Switch emulator, Ryubing (installed from Flathub)",
      "source": {"type": "flatpak", "ref": "io.github.ryubing.Ryujinx", "remote": "flathub"},
      "install": "/usr/bin/ryujinx", "systems": ["switch"]
    },
    {
      "id": "eglantine", "name": "Eglantine", "group": "EMULATORS",
      "description": "Nintendo Switch 2 emulator (very experimental)",
      "source": {"type": "gitea", "server": "https://git.eden-emu.dev", "repo": "Franseven/PokeDinner-a-Eglantine-Fork", "release": "recent", "asset": "-linux-x86_64\\.AppImage$"},
      "install": "/usr/bin/eglantine", "systems": ["switch2"]
    },
    {
      "id": "lichii", "name": "Lichii", "group": "EMULATORS",
      "description": "Nintendo Switch and Switch 2 emulator (very experimental)",
      "source": {"type": "github", "repo": "zortos293/Lichii", "release": "latest", "asset": "^lichii-linux-x86_64\\.AppImage$"},
      "install": "/usr/bin/lichii", "systems": ["switch", "switch2"]
    },
    {
      "id": "kyty", "name": "KytyPS5", "group": "EMULATORS",
      "description": "PlayStation 5 emulator (very experimental)",
      "source": {"type": "github", "repo": "KytyPS5/KytyPS5", "release": "latest", "asset": "-Linux-x86_64\\.tar\\.gz$", "archive": "tar.gz", "exe": "kyty_emulator"},
      "install": "/usr/bin/kyty", "systems": ["ps5"]
    },
    {
      "id": "windows-arcade-loader", "name": "Windows Arcade Loader", "group": "EMULATORS",
      "description": "Windows-based arcade games: Taito Type X, NESiCAxLive, Sega RingEdge, Namco ES3 and more (needs GE-Proton)",
      "source": {"type": "github", "repo": "aderumier/windowsarcadeloader", "release": "latest", "asset": "^windows-arcade-loader-.*\\.tar\\.gz$", "archive": "tar.gz", "exe": "arcade-launcher"},
      "install": "/usr/bin/windows-arcade-loader", "systems": ["typex"]
    },
    {
      "id": "lr-mame", "name": "MAME (RetroArch core)", "group": "RETROARCH CORES",
      "description": "Arcade: MAME, Namco System 22, CAVE CV1000, Gaelco, Sega Model 1/2/3 (large: 111 MB download, 400 MB installed)",
      "source": {"type": "libretro", "core": "mame"},
      "install": "/usr/lib/libretro/mame_libretro.so",
      "_extras": "MAME's hiscore plugin (Batocera's MAME setup loads it), from libretro/mame at a pinned commit",
      "extras": [
        {"url": "https://raw.githubusercontent.com/libretro/mame/283641602df2e427df61583083b317f96ba79a5b/plugins/hiscore/hiscore.dat",
         "install": "/usr/bin/mame/plugins/hiscore/hiscore.dat", "sha256": "0b7e8e53ee9366f10c75df7b8b7c57de1ba573a1089cafd0937423843f4a2fc9"},
        {"url": "https://raw.githubusercontent.com/libretro/mame/283641602df2e427df61583083b317f96ba79a5b/plugins/hiscore/init.lua",
         "install": "/usr/bin/mame/plugins/hiscore/init.lua", "sha256": "7893a2222624bb84d6b29bd939bc4b82ba0e8bf7cee752f68faf95b9f9f79706"},
        {"url": "https://raw.githubusercontent.com/libretro/mame/283641602df2e427df61583083b317f96ba79a5b/plugins/hiscore/plugin.json",
         "install": "/usr/bin/mame/plugins/hiscore/plugin.json", "sha256": "a8bff3d9247bb90d83c7d52e1bb9290eec721ff1190a5cac9c94e2c29a7dd412"},
        {"url": "https://raw.githubusercontent.com/libretro/mame/283641602df2e427df61583083b317f96ba79a5b/plugins/hiscore/sort_hiscore.lua",
         "install": "/usr/bin/mame/plugins/hiscore/sort_hiscore.lua", "sha256": "c9abd00f2033e37770d51dc8da1bbadddc33fd79b18e97c64d98dc17ff046493"}
      ]
    },
    {
      "id": "lr-dice", "name": "DICE (RetroArch core)", "group": "RETROARCH CORES",
      "description": "Arcade: early 1970s discrete-logic arcade games (Pong, Breakout...)",
      "source": {"type": "libretro", "core": "dice"},
      "install": "/usr/lib/libretro/dice_libretro.so"
    },
    {
      "id": "ge-proton", "name": "GE-Proton", "group": "EMULATORS",
      "description": "Wine runner used by the Windows Arcade Loader (large download)",
      "source": {"type": "github", "repo": "GloriousEggroll/proton-ge-custom", "release": "latest", "asset": "^GE-Proton[0-9-]+-x86_64\\.tar\\.gz$", "archive": "tar.gz", "exe": "proton"},
      "install": "/usr/bin/ge-proton"
    }
  ]
}
