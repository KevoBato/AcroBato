@@ -1134,6 +1134,12 @@ SystemData* SystemData::loadSystem(pugi::xml_node system, bool fullMode)
 
 	path = system.child("path").text().get();
 
+#if BATOCERA
+	// Relocatable layout (ES_USERDATA): es_systems.cfg is generated with /userdata paths
+	if (Utils::String::startsWith(path, "/userdata/") && Paths::getRootPath() != "/userdata")
+		path = Paths::getRootPath() + path.substr(9);
+#endif
+
 	SystemMetadata md;
 	md.name = system.child("name").text().get();
 	md.fullName = system.child("fullname").text().get();
