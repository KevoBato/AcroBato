diff --git a/es-app/src/ApiSystem.cpp b/es-app/src/ApiSystem.cpp
index 0ad2826..12c6ebd 100644
--- a/es-app/src/ApiSystem.cpp
+++ b/es-app/src/ApiSystem.cpp
@@ -2295,9 +2295,22 @@ bool ApiSystem::isScriptingSupported(ScriptId script)
 	if (executables.size() == 0)
 		return true;
 
+	// Relocatable layout: helper commands may live in ES_BIN (e.g. inside an AppImage)
+	// ES_BIN may list several folders separated by ':', like PATH
+	const char* envBin = getenv("ES_BIN");
+	std::vector<std::string> binDirs = { "/usr/bin" };
+	if (envBin && *envBin)
+		for (auto dir : Utils::String::split(envBin, ':', true))
+			binDirs.push_back(dir);
+
 	for (auto executable : executables)
-		if (!Utils::FileSystem::exists("/usr/bin/" + executable))
+	{
+		bool found = false;
+		for (auto dir : binDirs)
+			if (Utils::FileSystem::exists(dir + "/" + executable)) { found = true; break; }
+		if (!found)
 			return false;
+	}
 
 	return true;
 }
diff --git a/es-app/src/SystemData.cpp b/es-app/src/SystemData.cpp
index 544e92e..4c91bff 100644
--- a/es-app/src/SystemData.cpp
