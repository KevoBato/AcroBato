#!/bin/bash
# Runs an emulator and closes it before it runs the machine out of memory.
# Usage: acrobato-watchdog <emulator> [args...]
# Some Switch/Switch 2 games make the emulator use up all the RAM, which freezes the whole
# desktop long before Linux steps in. The emulator is started as the first thing to kill
# when memory runs out, in its own process group, and the free memory (RAM + free swap) is
# checked 4 times a second; below the limit the emulator is closed and AcroBato comes back.
# ACROBATO_MIN_FREE_MB=<MB> sets the limit (default 10% of RAM, at least 1.5 GB).
# (From the AcroBato Eglantine add-on for Batocera, minus the root-only parts.)

total_mb=0
while read -r name value _; do
  [ "$name" = "MemTotal:" ] && total_mb=$((value / 1024)) && break
done < /proc/meminfo
min_free_mb=${ACROBATO_MIN_FREE_MB:-$((total_mb / 10))}
[ -n "$ACROBATO_MIN_FREE_MB" ] || [ "$min_free_mb" -ge 1536 ] || min_free_mb=1536
echo "[acrobato-watchdog] ${total_mb} MB RAM, closes the emulator below ${min_free_mb} MB free"

(echo 1000 > /proc/self/oom_score_adj 2>/dev/null; exec setsid "$@") &
pid=$!
trap 'kill -TERM -- -"$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null' TERM INT

while kill -0 "$pid" 2>/dev/null; do
  available_mb=""; swap_free_mb=0
  while read -r name value _; do
    case "$name" in
      MemAvailable:) available_mb=$((value / 1024)) ;;
      SwapFree:) swap_free_mb=$((value / 1024)); break ;;
    esac
  done < /proc/meminfo
  if [ -n "$available_mb" ] && [ $((available_mb + swap_free_mb)) -lt "$min_free_mb" ]; then
    echo "[acrobato-watchdog] only $((available_mb + swap_free_mb)) MB of memory left, closing the emulator"
    kill -9 -- -"$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null
    break
  fi
  sleep 0.25
done
wait "$pid"
